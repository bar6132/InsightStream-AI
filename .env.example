# ============================================
# InsightStream AI - Environment Configuration
# ============================================

# --- API Configuration ---
# FastAPI/Uvicorn
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENVIRONMENT=production  # or "development"

# --- Database: Supabase (PostgreSQL + Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here  # Admin key, keep secret
SUPABASE_DB_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# --- Vector Database: Qdrant ---
QDRANT_URL=http://qdrant:6333  # or cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_if_cloud  # Leave blank if local
QDRANT_COLLECTION_NAME=news_vectors

# --- AI Services ---

# Groq (Primary LLM for summarization)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Embeddings)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# Ollama (Local Fallback - optional)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2  # or "mistral" for speed

# --- Message Broker: RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_NAME=ingestion_tasks

# --- Authentication ---
# JWT/Auth tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS Configuration ---
# Allowed origins for frontend requests (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Email Configuration (if needed) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=noreply@yourdomain.com

# --- Logging & Monitoring ---
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=/var/log/insightstream/app.log

# Sentry (Error tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# --- RSS Feed Configuration ---
RSS_UPDATE_INTERVAL_HOURS=6
MAX_ARTICLES_PER_FEED=5
RSS_FEEDS_LIST=http://feeds.feedburner.com/TechCrunch/,https://www.theverge.com/rss/index.xml

# --- Performance & Caching ---
CACHE_TTL_SECONDS=3600  # Cache expiration
REDIS_URL=redis://redis:6379/0  # Optional: for caching
MAX_WORKERS=10  # For concurrent processing

# --- Timeouts (in seconds) ---
API_REQUEST_TIMEOUT=30
EXTERNAL_API_TIMEOUT=10
DATABASE_TIMEOUT=5
RABBITMQ_TIMEOUT=5

# --- Feature Flags ---
ENABLE_HEALTH_CHECK=true
ENABLE_CORS=true
ENABLE_SWAGGER_UI=true
ENABLE_OLLAMA_FALLBACK=true
ENABLE_RATE_LIMITING=true

# --- Development Only ---
# Don't use these in production!
DEBUG=false  # Set to true ONLY in development
SKIP_AUTH=false  # Set to true ONLY for testing
MOCK_EXTERNAL_SERVICES=false  # Set to true for testing without real APIs

# --- Monitoring & Metrics ---
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_RETENTION_DAYS=30

# --- Cloud Storage (if applicable) ---
S3_BUCKET_NAME=insightstream-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key

# --- Backup Configuration ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30

# --- Version ---
APP_VERSION=0.2.0
